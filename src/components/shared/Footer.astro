---
import { site } from '../../data/site';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<footer class="footer">
  <p class="line">{site.footerLine}</p>
  <nav aria-label="Footer">
    <ul class="links">
      {
        site.footerLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="credits">
    <a href={site.credits.href} rel="license noopener" target="_blank">{site.credits.text}</a>
  </p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 28px;
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 40px var(--gutter);
    font-size: var(--text-label);
    line-height: 18px;
    color: var(--color-ink-muted);
  }
  @media (min-width: 768px) {
    .footer {
      /* Paper insets the footer 16px from the content edge. */
      padding-inline: calc(var(--gutter) + 16px);
    }
  }
  .credits {
    flex-basis: 100%;
  }
  .credits a {
    /* Long line: let it wrap on phones. */
    display: inline;
    padding-block: 0;
    margin-block: 0;
  }
  .links {
    display: flex;
    gap: 28px;
    list-style: none;
    padding: 0;
  }
  a {
    display: inline-block;
    /* Bigger tap target without moving the text. */
    padding-block: 12px;
    margin-block: -12px;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }
  a:hover {
    color: var(--color-ink);
  }
  a:active {
    opacity: 0.7;
  }
  a[aria-current='page'] {
    color: var(--color-ink);
    font-weight: var(--weight-medium);
  }
</style>
