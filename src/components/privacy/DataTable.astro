---
import { privacy } from '../../data/privacy';
const { leaves } = privacy;
---

<section class="leaves" aria-labelledby="leaves-title">
  <h2 id="leaves-title" class="h2">{leaves.title}</h2>
  <dl class="list">
    {
      leaves.items.map((item) => (
        <div class="row">
          <dt>{item.term}</dt>
          <dd>{item.text}</dd>
        </div>
      ))
    }
  </dl>
  <p class="note">{leaves.note}</p>
</section>

<style>
  .h2 {
    padding-bottom: 24px;
    font-size: clamp(1.625rem, 1.4rem + 0.8vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
  }
  .list {
    border-bottom: 1px solid var(--color-border);
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-block: 24px;
    border-top: 1px solid var(--color-border);
    font-size: 17px;
  }
  @media (min-width: 768px) {
    .row {
      flex-direction: row;
      gap: 32px;
    }
    dt {
      flex-shrink: 0;
      width: 160px;
    }
  }
  dt {
    line-height: 22px;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
  }
  dd {
    line-height: 27px;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }
  .note {
    padding-top: 20px;
    font-size: var(--text-small);
    line-height: 24px;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }
</style>
