---
import { privacy } from '../../data/privacy';
const { short } = privacy;
---

<section class="short" aria-labelledby="short-title">
  <p class="eyebrow">{short.label}</p>
  <div class="stack">
    <h2 id="short-title" class="h2">{short.title}</h2>
    <p class="lede">{short.text}</p>
  </div>
</section>

<style>
  .short {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 24px;
    border-radius: 24px;
    background: var(--color-accent-tint);
  }
  @media (min-width: 768px) {
    .short {
      padding: 32px 36px;
    }
  }
  .eyebrow {
    font-size: var(--text-label);
    line-height: 18px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .h2 {
    font-size: clamp(1.625rem, 1.4rem + 0.8vw, 1.875rem); /* 26 → 30 */
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    text-wrap: balance;
  }
  .lede {
    font-size: 18px;
    line-height: 27px;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }
</style>
