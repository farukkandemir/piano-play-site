---
/**
 * One painted cover: image, title, composer. Not a link.
 * Paper: "Chapter 1 · Choose" → cover card (200 × 200, radius 22, gap 12).
 */
import { Image } from 'astro:assets';
import type { Piece } from '../../data/choose';

interface Props {
  piece: Piece;
}

const { piece } = Astro.props;
---

<figure class="cover">
  <div class="art">
    <Image
      src={piece.image}
      alt={`Cover painting for ${piece.title}`}
      widths={[328, 400]}
      sizes="(max-width: 767px) 164px, 200px"
      width={400}
      height={400}
      format="webp"
      quality={80}
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption>
    <span class="piece">{piece.title}</span>
    <span class="composer">{piece.composer}</span>
  </figcaption>
</figure>

<style>
  .cover {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .art {
    aspect-ratio: 1;
    border-radius: var(--radius-cover);
    overflow: hidden;
    background: var(--color-paper);
    /* Keeps the rounded clip crisp while the image scales in Safari. */
    isolation: isolate;
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--ease-out);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .piece {
    font-size: var(--text-small); /* 15 */
    line-height: 18px;
    font-weight: var(--weight-medium);
    color: var(--color-ink);
  }

  .composer {
    font-size: 0.8125rem; /* 13 (Paper); no token for this size */
    line-height: 16px;
    color: var(--color-ink-muted);
  }

  /* A small, quiet answer to the pointer: the painting leans in a touch. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .cover:hover .art img {
      transform: scale(1.03);
    }
  }
</style>
