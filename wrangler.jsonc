// Cloudflare Workers config: the site is static, so the Worker only serves dist/.
{
  "name": "piano-play-site",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    // /privacy → privacy.html, unknown paths → 404.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
